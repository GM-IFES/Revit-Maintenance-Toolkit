        }
      ],
      "FunctionSignature": "DSCore.Data.ParseJSON@string",
      "Replication": "Auto",
      "Description": "O método Parse converte uma sequência de caracteres JSON arbitrária em um valor. É o oposto de JSON.Stringify.\n\nData.ParseJSON (json: string): var[]..[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# Revit Services\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\n# Obter versão do Revit\r\nuiapp = DocumentManager.Instance.CurrentUIApplication\r\napp = uiapp.Application\r\nrvt_year = int(app.VersionNumber)\r\n\r\n# Importação condicional das classes conforme versão\r\nclr.AddReference(\"RevitAPI\")\r\nif rvt_year > 2024:\r\n    from Autodesk.Revit.DB import GroupTypeId as GroupTypeClass\r\nelse:\r\n    from Autodesk.Revit.DB import BuiltInParameterGroup as GroupTypeClass\r\n\r\n# Entrada do JSON\r\ndata = IN[0]\r\n\r\n# Saídas\r\nname = []\r\nparameter_group = []\r\ninstance = []\r\n\r\n# Processa os dados\r\nfor item in data:\r\n    name.append(item.get(\"SharedParameterName\"))\r\n    instance.append(item.get(\"Instance\"))\r\n\r\n    if rvt_year > 2024:\r\n        parameter_group.append(GroupTypeClass.Ifc)\r\n    else:\r\n        parameter_group.append(GroupTypeClass.PG_IFC)\r\n\r\n# Saída para o Dynamo\r\nOUT = name, parameter_group, instance\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "f7d5708ba2ea454b8273c2d3d106649e",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "dde08b085d724e83a2678c5a7dfb1f2e",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
