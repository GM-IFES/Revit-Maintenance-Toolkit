    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "e375f93a6a094cb1bd5b1dc06d1910ac",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "efe8c6a5c1c94ac593c50764adb86ed4",
          "Name": "list",
          "Description": "A lista na qual localizar o elemento.\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2c238ca8caf040b2999282005ccf6bad",
          "Name": "element",
          "Description": "O elemento cujo índice deve ser retornado.\n\nvar",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "971407d8be1f4badb153537d0d4d4487",
          "Name": "int",
          "Description": "O índice do elemento na lista. Índice inválido – retornará 1 se não for encontrada uma correspondência exata.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "DSCore.List.IndexOf@var[]..[],var",
      "Replication": "Auto",
      "Description": "Retorna o índice do elemento na lista fornecida. A correspondência entre a lista fornecida e o elemento de destino deve ser exata (ou seja, int com int, double com double, string com string, object com object etc.).\n\nList.IndexOf (list: var[]..[], element: var): int"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# Referências Revit\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Documento ativo\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Entradas do Dynamo\r\nparam_defs = IN[0]           # Lista de ExternalDefinition\r\nparameter_groups = IN[1]     # Lista de BuiltInParameterGroup ou GroupTypeId\r\ninstance_flags = IN[2]       # Lista de True/False para instância/tipo\r\ncategorias_ids = IN[3]       # Lista de IDs das categorias\r\ncreate_params = IN[4]        # Valor booleano vindo do Custom Selection: True ou False\r\n\r\n# Função para obter nomes de parâmetros já existentes\r\ndef get_existing_param_names():\r\n    bindings = doc.ParameterBindings\r\n    it = bindings.ForwardIterator()\r\n    it.Reset()\r\n    names = []\r\n    while it.MoveNext():\r\n        definition = it.Key\r\n        names.append(definition.Name)\r\n    return names\r\n\r\nexisting_names = get_existing_param_names()\r\n\r\n# Inicializa listas de resultado\r\nadded_params = []\r\nresults = []\r\nmessages = []\r\n\r\n# Inicia transação\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor defn, group, is_inst in zip(param_defs, parameter_groups, instance_flags):\r\n    try:\r\n        name = defn.Name\r\n\r\n        # Criar parâmetro se solicitado\r\n        if create_params:\r\n            if name in existing_names:\r\n                messages.append(f\"'{name}' já existe no projeto.\")\r\n                results.append(False)\r\n                added_params.append(None)\r\n            else:\r\n                # Define categorias usando IDs\r\n                catSet = CategorySet()\r\n                for cid in categorias_ids:\r\n                    cat = doc.Settings.Categories.get_Item(cid)\r\n                    if cat and cat.AllowsBoundParameters:\r\n                        catSet.Insert(cat)\r\n\r\n                # Cria binding (instância ou tipo)\r\n                binding = InstanceBinding(catSet) if is_inst else TypeBinding(catSet)\r\n\r\n                # Insere o parâmetro no projeto\r\n                success = doc.ParameterBindings.Insert(defn, binding, group)\r\n                if success:\r\n                    messages.append(f\"'{name}' adicionado com sucesso.\")\r\n                    results.append(True)\r\n                    added_params.append(defn)\r\n                else:\r\n                    messages.append(f\"Falha ao adicionar '{name}'.\")\r\n                    results.append(False)\r\n                    added_params.append(None)\r\n        else:\r\n            # Apenas preenchimento\r\n            added_params.append(None)\r\n            results.append(True)\r\n\r\n        # Preencher \"N/A\" nos elementos existentes\r\n        param_elem_value = \"N/A\"\r\n        collector = FilteredElementCollector(doc).WhereElementIsNotElementType().ToElements()\r\n        for elem in collector:\r\n            param = elem.LookupParameter(name)\r\n            if param and param.StorageType == StorageType.String:\r\n                if not param.AsString():\r\n                    param.Set(param_elem_value)\r\n\r\n    except Exception as e:\r\n        messages.append(f\"Erro com '{defn.Name}': {str(e)}\")\r\n        results.append(False)\r\n        added_params.append(None)\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# Saída\r\nOUT = added_params, results, messages\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "53fa4cb2f5d44056952c706ae7cee5a3",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "fa51a505b98247d383cee0a7d28b0eaf",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
