    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Texto padrão\r\nimport clr\r\n\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\n# Documento/aplicativo/interface atual\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\n\r\n# Inicialização de listas para armazenar apenas os parâmetros\r\nparamDefs, paramNames = [], []\r\n\r\n# Abrindo o arquivo de parâmetros compartilhados\r\nfile = app.OpenSharedParameterFile()\r\n\r\n# Obtendo os grupos de parâmetros\r\ngroups = file.Groups\r\n\r\n# Iterando sobre os grupos e suas definições\r\nfor group in groups:\r\n    for d in group.Definitions:\r\n        paramDefs.append(d)  # Adicionando definição do parâmetro à lista\r\n        paramNames.append(d.Name)  # Adicionando nome do parâmetro à lista\r\n\r\n# Preparando a saída para o Dynamo\r\nOUT = paramDefs, paramNames\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "38cfc5b1b9a5426f9bda781b9f3943fe",
      "NodeType": "PythonScriptNode",
      "Inputs": [
