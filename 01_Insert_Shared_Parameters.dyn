    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Documento e aplicação\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication\r\napp = uiapp.Application\r\n\r\n# Caminho do arquivo TXT de parâmetros compartilhados (input do Dynamo)\r\nshared_params_file = IN[0]\r\n\r\n# Configura o Revit para usar este arquivo\r\napp.SharedParametersFilename = shared_params_file\r\n\r\n# Feedback para o usuário\r\nOUT = \"✅ Arquivo de parâmetros compartilhados registrado no Revit:\\n{}\".format(shared_params_file)\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
